[Unit]
Description=Deepin Anything Index Service
After=dbus.service

[Service]
Type=forking
ExecStart=/usr/bin/deepin-security-loader --group deepin-daemon -- /usr/libexec/deepin/deepin-anything-index
Slice=session.slice
Restart=on-failure
RestartSec=5s
MemoryAccounting=yes
MemoryHigh=900M
MemoryMax=2G

# No [Install]: the unit is pulled on demand through D-Bus activation only.
